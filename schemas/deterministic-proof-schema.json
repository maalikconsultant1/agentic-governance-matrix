{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deterministic Proof Artifact",
  "description": "The immutable, regulator-ready audit trail generated by the RegOps Interceptor.",
  "type": "object",
  "required": ["artifact_id", "timestamp", "agent_id", "intent_hash", "boundary_check", "regulatory_controls", "execution_result"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "Cryptographically unique identifier for this proof."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agent_id": {
      "type": "string",
      "description": "Non-Human Identity (NHI) of the executing agent."
    },
    "intent_hash": {
      "type": "string",
      "description": "Hash of the strategic 'why' verified before execution."
    },
    "boundary_check": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "BLOCK", "ESCALATE"] },
        "perimeter": { "type": "string", "description": "e.g., PDPL_Data_Sovereignty" }
      }
    },
    "regulatory_controls": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mapped controls (e.g., SAMA-CSF-3.2.1, PDPL-Article-4)."
    },
    "execution_result": {
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "payload_hash": { "type": "string" }
      }
    }
  }
}
